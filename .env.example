# Server Port
PORT=3000

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# TMDB API Key (v3 auth key)
TMDB_API_KEY=your-tmdb-api-key

# OMDb API Key (optional, for IMDb ratings and awards enrichment: https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your-omdb-api-key

# Minimum movies required in database to publish a home category
MIN_MOVIES_PER_CATEGORY=6

# Cron schedule for category regeneration (Default: every 6 hours)
CATEGORIES_CRON_SCHEDULE=0 */6 * * *

# Cron schedule for movie metadata sync (Default: every 2 hours)
MOVIES_SYNC_CRON_SCHEDULE=0 */2 * * *
